# FoodVerse AI — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.

# -----------------------------------------------------------------------------
# Google Gemini API Key (REQUIRED)
# Used by all 5 AI features: Food Recognition, Freshness Detection,
# Hygiene Monitoring, Cooking Assistant, Meal Planner.
# Get your key at: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Backend Server Port (OPTIONAL — defaults to 8000)
# -----------------------------------------------------------------------------
PORT=8000

# -----------------------------------------------------------------------------
# Future / Planned Integrations (not yet active)
# Uncomment and fill in when integrating the corresponding module.
# -----------------------------------------------------------------------------

# HuggingFace token — required to download gated LLaMA model weights
# HUGGINGFACE_TOKEN=hf_your_token_here

# LLaMA model path — local path to GGUF weights (llama-cpp-python)
# LLAMA_MODEL_PATH=./models/llama-3.2-3b-instruct.gguf

# Ollama server URL (if using Ollama for local LLaMA inference)
# OLLAMA_BASE_URL=http://localhost:11434
